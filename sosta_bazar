<!DOCTYPE html>
<html lang="bn" class="overflow-x-hidden">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>সস্তা বাজার — সেরা দামে আসল পণ্য</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Canvas Confetti CDN -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

  <!-- Google Fonts: Hind Siliguri -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      font-family: 'Hind Siliguri', sans-serif;
    }
    html, body {
      overflow-x: hidden !important;
      max-width: 100vw !important;
      width: 100% !important;
      margin: 0;
      padding: 0;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 4px;
      height: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: #090d16;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #1e293b;
      border-radius: 4px;
    }
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    @keyframes slideIn {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
    .animate-slideIn {
      animation: slideIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    /* SVG Icon Helper Style */
    .icon {
      display: inline-block;
      width: 1em;
      height: 1em;
      stroke-width: 0;
      stroke: currentColor;
      fill: currentColor;
      vertical-align: middle;
    }
  </style>
</head>
<body class="bg-[#0b0f19] text-slate-100 min-h-screen relative selection:bg-emerald-500 selection:text-white pb-24 md:pb-10 w-full overflow-x-hidden">

  <!-- ========================================== -->
  <!-- INLINE SVG SYMBOLS (100% BULLETPROOF ICONS) -->
  <!-- ========================================== -->
  <svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
    <!-- Basket / Bag Logo -->
    <symbol id="icon-basket" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <path d="M16 10a4 4 0 0 1-8 0"></path>
    </symbol>

    <!-- Cart Shopping -->
    <symbol id="icon-cart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="21" r="1"></circle>
      <circle cx="20" cy="21" r="1"></circle>
      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
    </symbol>

    <!-- Heart Outline -->
    <symbol id="icon-heart-outline" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
    </symbol>

    <!-- Heart Filled -->
    <symbol id="icon-heart-fill" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
    </symbol>

    <!-- User / Profile -->
    <symbol id="icon-user" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
      <circle cx="12" cy="7" r="4"></circle>
    </symbol>

    <!-- Search Magnifying Glass -->
    <symbol id="icon-search" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </symbol>

    <!-- Package / Box (Orders) -->
    <symbol id="icon-box" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
      <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
      <line x1="12" y1="22.08" x2="12" y2="12"></line>
    </symbol>

    <!-- Home -->
    <symbol id="icon-home" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
      <polyline points="9 22 9 12 15 12 15 22"></polyline>
    </symbol>

    <!-- Bolt / Lightning (Buy Now) -->
    <symbol id="icon-bolt" viewBox="0 0 24 24" fill="currentColor">
      <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
    </symbol>

    <!-- Eye (Details) -->
    <symbol id="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
      <circle cx="12" cy="12" r="3"></circle>
    </symbol>

    <!-- Star -->
    <symbol id="icon-star" viewBox="0 0 24 24" fill="currentColor">
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
    </symbol>

    <!-- Cross / Close (X) -->
    <symbol id="icon-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </symbol>

    <!-- Ticket / Coupon -->
    <symbol id="icon-ticket" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 9a3 3 0 0 1 0 6v5a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5a3 3 0 0 1 0-6V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"></path>
      <line x1="13" y1="3" x2="13" y2="21" stroke-dasharray="2 2"></line>
    </symbol>

    <!-- Phone -->
    <symbol id="icon-phone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </symbol>

    <!-- Trash / Delete -->
    <symbol id="icon-trash" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="3 6 5 6 21 6"></polyline>
      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
    </symbol>

    <!-- Copy -->
    <symbol id="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </symbol>

    <!-- Chevron Left -->
    <symbol id="icon-chevron-left" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"></polyline>
    </symbol>

    <!-- Chevron Right -->
    <symbol id="icon-chevron-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"></polyline>
    </symbol>

    <!-- Category: Grocery Basket -->
    <symbol id="icon-cat-grocery" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <path d="M16 10a4 4 0 0 1-8 0"></path>
    </symbol>

    <!-- Category: Gadgets -->
    <symbol id="icon-cat-gadget" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
      <line x1="12" y1="18" x2="12.01" y2="18"></line>
    </symbol>

    <!-- Category: Fashion -->
    <symbol id="icon-cat-fashion" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.5a2 2 0 0 0 1.94 1.67H7v10a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V10.86h2.2a2 2 0 0 0 1.94-1.67l.58-3.5a2 2 0 0 0-1.34-2.23z"></path>
    </symbol>
  </svg>

  <!-- Toast Notification Box -->
  <div id="toastBox" class="fixed top-4 right-3 left-3 sm:left-auto sm:right-4 z-[9999] flex flex-col gap-2 max-w-sm pointer-events-none"></div>

  <!-- 1. Top Notice Announcement Bar -->
  <div id="userNoticeBar" class="bg-gradient-to-r from-emerald-800 via-teal-700 to-emerald-900 text-white text-xs py-1.5 px-3 sm:px-4 shadow-sm sticky top-0 z-50 w-full">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      <div class="flex items-center gap-1.5 min-w-0 flex-1 overflow-hidden">
        <span class="flex h-2 w-2 relative shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-300 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-300"></span>
        </span>
        <span id="noticeText" class="font-bold text-[11px] sm:text-xs truncate">
          সস্তা বাজারে স্বাগতম! সারা দেশে দ্রুত হোম ডেলিভারি ও বিশেষ ছাড়।
        </span>
      </div>
      <div class="flex items-center gap-1.5 shrink-0">
        <button onclick="applyHeroCoupon()" class="px-2 py-0.5 rounded-lg bg-emerald-950/80 hover:bg-emerald-900 border border-emerald-500/40 text-amber-300 font-mono font-bold text-[10px] sm:text-[11px] transition flex items-center gap-1">
          <svg class="w-3 h-3 text-amber-300"><use href="#icon-ticket"></use></svg>
          <span id="topCouponTag">SASTA2026</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 2. Store Header (Fully Responsive - Pristine SVG Icons) -->
  <header class="sticky top-8 z-40 bg-[#0d1322]/95 backdrop-blur-md border-b border-slate-800/80 px-3 sm:px-6 py-2.5 sm:py-3 shadow-md w-full">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-2">
      
      <!-- Brand Logo (Clean Vector SVG, never broken) -->
      <div class="flex items-center gap-2 cursor-pointer select-none shrink-0" onclick="filterUserCategory('all')">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 flex items-center justify-center text-white shadow-md shadow-emerald-500/20 shrink-0">
          <svg class="w-5 h-5 text-white"><use href="#icon-basket"></use></svg>
        </div>
        <div>
          <h1 class="text-base sm:text-lg font-black text-white leading-tight">
            সস্তা<span class="text-emerald-400">বাজার</span>
          </h1>
          <p class="text-[9px] text-slate-400 font-bold uppercase tracking-wider hidden sm:block">সেরা দামে সেরা পণ্য</p>
        </div>
      </div>

      <!-- Desktop Search Bar -->
      <div class="hidden md:flex flex-1 max-w-md mx-4 relative">
        <input 
          type="text" 
          id="userSearchInput" 
          oninput="renderUserProducts()" 
          placeholder="মুদি বাজার, স্মার্ট গ্যাজেট, পোশাক খুঁজুন..." 
          class="w-full pl-9 pr-8 py-2 bg-slate-800/90 border border-slate-700/80 rounded-full text-xs text-white placeholder-slate-400 focus:outline-none focus:border-emerald-500 transition" 
        />
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"><use href="#icon-search"></use></svg>
        <button id="clearSearchBtn" onclick="clearSearch()" class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white">
          <svg class="w-3.5 h-3.5"><use href="#icon-x"></use></svg>
        </button>
      </div>

      <!-- Header Action Buttons -->
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        
        <!-- Wishlist Button -->
        <button onclick="openWishlistModal()" class="relative p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-rose-400 text-xs font-bold transition flex items-center border border-slate-700/70" title="পছন্দের তালিকা">
          <svg class="w-4 h-4 text-rose-400"><use href="#icon-heart-outline"></use></svg>
          <span id="wishlistBadgeCount" class="hidden absolute -top-1 -right-1 w-4 h-4 bg-rose-500 text-white text-[9px] font-black rounded-full flex items-center justify-center">0</span>
        </button>

        <!-- Orders Button (Desktop only) -->
        <button onclick="openMyOrdersModal()" class="hidden sm:flex relative px-2.5 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold transition items-center gap-1.5 border border-slate-700/70" title="আমার অর্ডারসমূহ">
          <svg class="w-4 h-4 text-emerald-400"><use href="#icon-box"></use></svg>
          <span>অর্ডার</span>
          <span id="ordersBadgeCount" class="hidden absolute -top-1 -right-1 w-4 h-4 bg-emerald-500 text-white text-[9px] font-black rounded-full flex items-center justify-center">0</span>
        </button>

        <!-- Cart Button -->
        <button onclick="openCartDrawer()" class="relative px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition flex items-center gap-1.5 shadow-md shadow-emerald-600/30">
          <svg class="w-4 h-4 text-white"><use href="#icon-cart"></use></svg>
          <span class="hidden sm:inline">কার্ট</span>
          <span id="cartBadgeCount" class="w-4 h-4 sm:w-5 sm:h-5 rounded-full bg-amber-400 text-slate-950 flex items-center justify-center text-[10px] sm:text-[11px] font-black">0</span>
        </button>

        <!-- Profile Button -->
        <button onclick="openProfileModal()" class="p-1.5 sm:px-2.5 sm:py-1.5 rounded-xl sm:rounded-full bg-slate-800 hover:bg-slate-700 border border-slate-700/70 text-slate-200 text-xs font-bold transition flex items-center gap-1.5" title="আমার প্রোফাইল ও আইডি">
          <div class="w-6 h-6 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xs shrink-0">
            <svg class="w-3.5 h-3.5 text-emerald-400"><use href="#icon-user"></use></svg>
          </div>
          <span id="headerProfileName" class="hidden md:inline text-xs">প্রোফাইল</span>
        </button>

      </div>

    </div>

    <!-- Mobile Search Bar -->
    <div class="mt-2 md:hidden relative w-full">
      <input 
        type="text" 
        id="userSearchInputMobile" 
        oninput="renderUserProducts()" 
        placeholder="মুদি, গ্যাজেট বা পণ্য খুঁজুন..." 
        class="w-full pl-8 pr-8 py-1.5 bg-slate-800/90 border border-slate-700/80 rounded-xl text-xs text-white placeholder-slate-400 focus:outline-none focus:border-emerald-500" 
      />
      <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2"><use href="#icon-search"></use></svg>
    </div>
  </header>

  <!-- 3. Hero Promotional Banner -->
  <section class="max-w-7xl mx-auto px-3 sm:px-6 pt-3 sm:pt-5 w-full">
    <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl bg-gradient-to-r from-emerald-950/90 via-slate-900 to-teal-950/90 border border-emerald-800/30 p-4 sm:p-7 md:p-8 shadow-xl">
      <div class="max-w-xl space-y-2 sm:space-y-3 relative z-10">
        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-amber-400 text-slate-950 inline-block shadow-xs">
          🔥 মেগা ডিসকাউন্ট অফার ২০২৬
        </span>
        <h2 class="text-lg sm:text-2xl md:text-3xl font-black text-white leading-snug">
          প্রতিদিনের বাজার, <span class="text-emerald-400">এখন সবচেয়ে সস্তায়!</span>
        </h2>
        <p class="text-[11px] sm:text-xs text-slate-300 line-clamp-2">
          ১০০% আসল পণ্য, দ্রুততম হোম ডেলিভারি ও সহজ ক্যাশ অন ডেলিভারি সুবিধা।
        </p>
        <div class="pt-1 flex flex-wrap items-center gap-2">
          <div class="px-2.5 py-1 rounded-xl bg-slate-800/90 border border-slate-700/80 text-[11px] text-slate-300 flex items-center gap-1.5">
            <span>কুপন:</span>
            <strong id="heroCouponCode" class="text-amber-300 font-mono font-bold">SASTA2026</strong>
            <button onclick="applyHeroCoupon()" class="px-1.5 py-0.5 bg-emerald-600 hover:bg-emerald-500 text-white text-[9px] font-bold rounded">
              প্রয়োগ
            </button>
          </div>
          <button onclick="document.getElementById('productsSection').scrollIntoView({ behavior: 'smooth' })" class="px-3 py-1 bg-emerald-600 hover:bg-emerald-500 text-white text-[11px] font-bold rounded-xl transition shadow-xs flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-white"><use href="#icon-basket"></use></svg>
            <span>কিনুন &darr;</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Category Filter & Sorting -->
  <section class="max-w-7xl mx-auto px-3 sm:px-6 pt-4 sm:pt-6 w-full">
    <div class="flex items-center justify-between gap-2 mb-2.5">
      <div class="flex items-center gap-1.5">
        <h3 class="text-sm sm:text-base font-black text-white">পণ্য বিভাগসমূহ</h3>
      </div>
      <div class="flex items-center gap-1 bg-slate-800/90 px-2 py-1 rounded-xl border border-slate-700/80">
        <span class="text-[10px] text-slate-400 font-bold hidden sm:inline">সাজান:</span>
        <select id="sortOption" onchange="renderUserProducts()" class="bg-transparent text-[11px] font-bold text-white focus:outline-none cursor-pointer">
          <option value="default" class="bg-slate-900">ডিফল্ট</option>
          <option value="low-to-high" class="bg-slate-900">মূল্য: কম-বেশি</option>
          <option value="high-to-low" class="bg-slate-900">মূল্য: বেশি-কম</option>
          <option value="rating" class="bg-slate-900">সর্বোচ্চ রেটিং</option>
        </select>
      </div>
    </div>

    <!-- Category Pills -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1.5 no-scrollbar text-xs font-bold w-full">
      <button onclick="filterUserCategory('all')" class="cat-pill px-3 py-1.5 rounded-xl bg-emerald-600 text-white transition shrink-0 text-xs" data-cat="all">
        সকল পণ্য
      </button>
      <button onclick="filterUserCategory('groceries')" class="cat-pill px-3 py-1.5 rounded-xl bg-slate-800 text-slate-300 hover:text-white transition shrink-0 text-xs" data-cat="groceries">
        <svg class="w-3.5 h-3.5 text-orange-400 mr-1 inline"><use href="#icon-cat-grocery"></use></svg> মুদি ও বাজার
      </button>
      <button onclick="filterUserCategory('gadgets')" class="cat-pill px-3 py-1.5 rounded-xl bg-slate-800 text-slate-300 hover:text-white transition shrink-0 text-xs" data-cat="gadgets">
        <svg class="w-3.5 h-3.5 text-blue-400 mr-1 inline"><use href="#icon-cat-gadget"></use></svg> স্মার্ট গ্যাজেট
      </button>
