      const clearBtn = document.getElementById('clearSearchBtn');
      if (clearBtn) {
        if (q) clearBtn.classList.remove('hidden');
        else clearBtn.classList.add('hidden');
      }

      let filtered = products.filter(p => {
        const matchCat = selectedUserCat === 'all' || p.category === selectedUserCat;
        const matchSearch = !q || (p.name || '').toLowerCase().includes(q) || (p.description || '').toLowerCase().includes(q);
        return matchCat && matchSearch;
      });

      const sort = document.getElementById('sortOption')?.value || 'default';
      if (sort === 'low-to-high') filtered.sort((a, b) => a.price - b.price);
      else if (sort === 'high-to-low') filtered.sort((a, b) => b.price - a.price);
      else if (sort === 'rating') filtered.sort((a, b) => (b.rating || 0) - (a.rating || 0));

