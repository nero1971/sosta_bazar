      if (!detailedProductObj) return;
      const imgList = (Array.isArray(detailedProductObj.images) && detailedProductObj.images.length > 0) ? detailedProductObj.images : [detailedProductObj.image];
      activeDetailImgIdx = (activeDetailImgIdx + delta + imgList.length) % imgList.length;
      renderProductDetailsBody();
    };

    window.setDetailImageIndex = function(idx) {
      activeDetailImgIdx = idx;
      renderProductDetailsBody();
    };

    // Wishlist Logic
    window.toggleWishlist = function(prodId) {
      const idStr = String(prodId);
      if (wishlist.includes(idStr)) {
        wishlist = wishlist.filter(x => x !== idStr);
        showToast('উইশলিস্ট থেকে সরানো হয়েছে', 'info');
      } else {
        wishlist.push(idStr);
        showToast('পছন্দের তালিকায় যোগ হয়েছে!', 'success');
      }
      localStorage.setItem('sb_wishlist', JSON.stringify(wishlist));
      updateWishlistBadge();
      renderUserProducts();
      if (detailedProductObj) renderProductDetailsBody();
      renderWishlistModal();
    };

    function updateWishlistBadge() {
      const count = wishlist.length;
      const badge = document.getElementById('wishlistBadgeCount');
      if (badge) {
        if (count > 0) {
          badge.innerText = count;
          badge.classList.remove('hidden');
        } else {
          badge.classList.add('hidden');
        }
      }
      const bBadge = document.getElementById('bottomWishlistBadge');
      if (bBadge) {
        if (count > 0) {
          bBadge.innerText = count;
          bBadge.classList.remove('hidden');
        } else {
          bBadge.classList.add('hidden');
        }
      }
    }

    window.openWishlistModal = function() {
      renderWishlistModal();
      document.getElementById('wishlistModal')?.classList.remove('hidden');
    };

    function renderWishlistModal() {
      const list = document.getElementById('wishlistItemsList');
      if (!list) return;
      const wishProds = products.filter(p => wishlist.includes(String(p.id)));

      if (wishProds.length === 0) {
        list.innerHTML = `
          <div class="py-10 text-center text-slate-400">
            <svg class="w-8 h-8 text-slate-600 mx-auto mb-1.5"><use href="#icon-heart-outline"></use></svg>
            <p class="font-bold text-xs">আপনার পছন্দের তালিকা খালি</p>
          </div>
        `;
        return;
      }

      list.innerHTML = wishProds.map(p => `
        <div class="flex items-center gap-2.5 p-2 bg-slate-800/80 rounded-xl border border-slate-700/80">
          <img src="${p.image}" class="w-10 h-10 object-cover rounded-lg shrink-0" />
          <div class="flex-1 min-w-0">
            <p class="font-bold text-white text-xs truncate">${p.name}</p>
            <p class="text-emerald-400 font-bold text-xs">৳${p.price}</p>
          </div>
          <button onclick="addToCart('${p.id}'); toggleWishlist('${p.id}')" class="px-2 py-1 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-bold transition flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-white"><use href="#icon-cart"></use></svg>
          </button>
        </div>
      `).join('');
    }

    // Cart Operations
    window.addToCart = function(prodId) {
      const p = products.find(item => String(item.id) === String(prodId));
      if (!p) return;
      if (p.inStock === false) {
        showToast(`${p.name} বর্তমানে স্টকে নেই!`, 'error');
        return;
      }

      const existing = cart.find(item => String(item.id) === String(p.id));
      if (existing) {
        existing.quantity += 1;
      } else {
        cart.push({ ...p, quantity: 1 });
      }

      localStorage.setItem('sb_cart', JSON.stringify(cart));
      updateCartBadge();
      showToast(`${p.name} কার্টে যোগ হয়েছে!`, 'success');
    };

    window.directBuyNow = function(prodId) {
      addToCart(prodId);
      closeProductDetailsModal();
      openCartDrawer();
    };

    function updateCartBadge() {
      const totalCount = cart.reduce((sum, it) => sum + (it.quantity || 1), 0);
      const topBadge = document.getElementById('cartBadgeCount');
      if (topBadge) topBadge.innerText = totalCount;
      const bottomBadge = document.getElementById('bottomCartBadge');
      if (bottomBadge) {
        if (totalCount > 0) {
          bottomBadge.innerText = totalCount;
          bottomBadge.classList.remove('hidden');
        } else {
          bottomBadge.classList.add('hidden');
        }
      }
      const profCount = document.getElementById('profileCartCount');
      if (profCount) profCount.innerText = `${totalCount} টি`;
    }

    window.openCartDrawer = function() {
      renderCartDrawerItems();
      calculateCartTotal();
      document.getElementById('cartDrawer')?.classList.remove('hidden');
    };

    window.closeCartDrawer = function() {
      document.getElementById('cartDrawer')?.classList.add('hidden');
    };

    function renderCartDrawerItems() {
      const container = document.getElementById('cartItemsContainer');
      const checkoutSec = document.getElementById('checkoutSection');
      if (!container || !checkoutSec) return;

      if (cart.length === 0) {
        container.innerHTML = `
          <div class="py-14 text-center text-slate-400">
            <svg class="w-10 h-10 text-slate-700 mx-auto mb-2"><use href="#icon-basket"></use></svg>
            <p class="font-bold text-white text-xs">আপনার কার্ট খালি!</p>
            <p class="text-[11px] text-slate-400 mt-1">পছন্দের পণ্য কার্টে যোগ করে অর্ডার করুন।</p>
          </div>
        `;
        checkoutSec.classList.add('hidden');
        return;
      }

      checkoutSec.classList.remove('hidden');
      container.innerHTML = cart.map((item, idx) => `
        <div class="flex items-center gap-2.5 p-2 bg-slate-800/80 rounded-xl border border-slate-700/80">
          <img src="${item.image}" alt="${item.name}" class="w-11 h-11 object-cover rounded-lg bg-slate-900 shrink-0" />
          <div class="flex-1 min-w-0">
            <h4 class="font-bold text-xs text-white truncate">${item.name}</h4>
            <div class="text-xs font-black text-emerald-400">৳${item.price}</div>
            <div class="flex items-center gap-1.5 mt-1 bg-slate-900 w-max rounded p-0.5 border border-slate-700">
              <button onclick="changeCartQty(${idx}, -1)" class="w-4 h-4 flex items-center justify-center font-bold text-slate-300 hover:text-white text-xs">-</button>
              <span class="text-[11px] font-bold w-3 text-center text-white">${item.quantity}</span>
              <button onclick="changeCartQty(${idx}, 1)" class="w-4 h-4 flex items-center justify-center font-bold text-slate-300 hover:text-white text-xs">+</button>
            </div>
          </div>
          <button onclick="removeCartItem(${idx})" class="text-slate-400 hover:text-rose-400 p-1">
            <svg class="w-4 h-4 text-slate-400 hover:text-rose-400"><use href="#icon-trash"></use></svg>
          </button>
        </div>
      `).join('');
    }

    window.changeCartQty = function(idx, delta) {
      if (!cart[idx]) return;
      cart[idx].quantity += delta;
      if (cart[idx].quantity <= 0) {
        cart.splice(idx, 1);
      }
      localStorage.setItem('sb_cart', JSON.stringify(cart));
      updateCartBadge();
      renderCartDrawerItems();
      calculateCartTotal();
    };

    window.removeCartItem = function(idx) {
      cart.splice(idx, 1);
      localStorage.setItem('sb_cart', JSON.stringify(cart));
      updateCartBadge();
      renderCartDrawerItems();
      calculateCartTotal();
      showToast('পণ্যটি সরানো হয়েছে', 'info');
    };

    // Delivery Zone & Price Calculation
    window.setDeliveryZone = function(zone) {
      selectedDeliveryZone = zone;
      const btnIn = document.getElementById('btnZoneIn');
      const btnOut = document.getElementById('btnZoneOut');
      const btnAll = document.getElementById('btnZoneAll');

      const activeClass = 'p-1.5 rounded-xl border border-emerald-500 bg-emerald-500/20 text-emerald-300 text-[10px] font-bold';
      const inactiveClass = 'p-1.5 rounded-xl border border-slate-700 bg-slate-800 text-slate-400 text-[10px] font-bold';

      if (btnIn) btnIn.className = zone === 'inside' ? activeClass : inactiveClass;
      if (btnOut) btnOut.className = zone === 'outside' ? activeClass : inactiveClass;
      if (btnAll) btnAll.className = zone === 'all' ? activeClass : inactiveClass;

      calculateCartTotal();
    };

    window.setPaymentMethod = function(method) {
      selectedPaymentMethod = method;
      const btnCod = document.getElementById('btnPayCod');
      const btnMfs = document.getElementById('btnPayMfs');
      const mfsBox = document.getElementById('mfsTrxBox');

      if (method === 'COD') {
        if (btnCod) btnCod.className = 'p-2 rounded-xl border-2 border-emerald-500 bg-emerald-500/20 text-emerald-300 font-bold text-xs text-center';
        if (btnMfs) btnMfs.className = 'p-2 rounded-xl border-2 border-slate-700 bg-slate-800 text-slate-400 font-bold text-xs text-center';
        mfsBox?.classList.add('hidden');
      } else {
        if (btnCod) btnCod.className = 'p-2 rounded-xl border-2 border-slate-700 bg-slate-800 text-slate-400 font-bold text-xs text-center';
        if (btnMfs) btnMfs.className = 'p-2 rounded-xl border-2 border-pink-500 bg-pink-500/20 text-pink-300 font-bold text-xs text-center';
        mfsBox?.classList.remove('hidden');
      }
    };

    function calculateCartTotal() {
      const subtotal = cart.reduce((sum, item) => sum + (Number(item.price) * Number(item.quantity)), 0);
      const fee = selectedDeliveryZone === 'inside' 
        ? (storeSettings.deliveryIn || 60) 
        : selectedDeliveryZone === 'outside' 
        ? (storeSettings.deliveryOut || 120) 
        : (storeSettings.deliveryAll || 80);

      const discountAmount = activeAppliedCoupon && subtotal > 0
        ? Math.round((subtotal * (storeSettings.couponDiscount || 10)) / 100)
        : 0;

      const grandTotal = subtotal > 0 ? (subtotal + fee - discountAmount) : 0;

      const subEl = document.getElementById('cartSubtotal');
      if (subEl) subEl.innerText = `৳${subtotal}`;
      const feeEl = document.getElementById('cartDeliveryFeeDisplay');
      if (feeEl) feeEl.innerText = `৳${fee}`;
      
      const discRow = document.getElementById('cartDiscountRow');
      const discEl = document.getElementById('cartDiscountDisplay');
      if (discountAmount > 0) {
        if (discEl) discEl.innerText = `-৳${discountAmount}`;
        discRow?.classList.remove('hidden');
      } else {
        discRow?.classList.add('hidden');
      }

      const grandEl = document.getElementById('cartGrandTotal');
      if (grandEl) grandEl.innerText = `৳${grandTotal}`;
      return { subtotal, fee, discountAmount, grandTotal };
    }

    // Coupon Logic
    window.applyHeroCoupon = function() {
      const code = storeSettings.couponCode || 'SASTA2026';
      activeAppliedCoupon = code.toUpperCase();
      const badgeText = document.getElementById('appliedCouponText');
      if (badgeText) badgeText.innerText = `${activeAppliedCoupon} (${storeSettings.couponDiscount || 10}% ছাড়)`;
      document.getElementById('appliedCouponBadge')?.classList.remove('hidden');
      document.getElementById('couponInputRow')?.classList.add('hidden');
      calculateCartTotal();
      showToast(`${storeSettings.couponDiscount || 10}% কুপন ডিসকাউন্ট যোগ হয়েছে!`, 'success');
    };

    window.applyCouponFromInput = function() {
      const val = (document.getElementById('couponInput')?.value || '').trim().toUpperCase();
      const valid = (storeSettings.couponCode || 'SASTA2026').toUpperCase();
      if (val === valid) {
        activeAppliedCoupon = val;
        const badgeText = document.getElementById('appliedCouponText');
        if (badgeText) badgeText.innerText = `${activeAppliedCoupon} (${storeSettings.couponDiscount || 10}% ছাড়)`;
        document.getElementById('appliedCouponBadge')?.classList.remove('hidden');
        document.getElementById('couponInputRow')?.classList.add('hidden');
        calculateCartTotal();
        showToast(`${storeSettings.couponDiscount || 10}% কুপন ডিসকাউন্ট যোগ হয়েছে!`, 'success');
      } else {
        showToast('ভুল কুপন কোড!', 'error');
      }
    };

    window.removeCoupon = function() {
      activeAppliedCoupon = null;
      document.getElementById('appliedCouponBadge')?.classList.add('hidden');
      document.getElementById('couponInputRow')?.classList.remove('hidden');
      const inp = document.getElementById('couponInput');
      if (inp) inp.value = '';
      calculateCartTotal();
      showToast('কুপন বাদ দেওয়া হয়েছে', 'info');
    };

    // Place Order to Firestore
    window.handlePlaceOrder = async function(e) {
      e.preventDefault();
      if (cart.length === 0) {
        showToast('আপনার কার্ট খালি!', 'error');
        return;
      }

      const name = document.getElementById('custName')?.value.trim();
      const phone = document.getElementById('custPhone')?.value.trim();
      const address = document.getElementById('custAddress')?.value.trim();
      const orderNote = document.getElementById('custOrderNote')?.value.trim() || '';
      const mfsPhone = document.getElementById('custMfsPhone')?.value.trim() || '';
      const mfsTrx = document.getElementById('custTrxId')?.value.trim() || '';

      if (!name || !phone || !address) {
        showToast('অনুগ্রহ করে নাম, মোবাইল নম্বর ও ঠিকানা দিন', 'error');
        return;
      }

      if (selectedPaymentMethod === 'MFS' && (!mfsPhone || !mfsTrx)) {
        showToast('বিকাশ/নগদ নম্বর ও TrxID দিন', 'error');
        return;
      }

      const submitBtn = document.getElementById('btnSubmitOrder');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>প্রসেস হচ্ছে...</span>';
      }

      try {
        const { subtotal, fee, discountAmount, grandTotal } = calculateCartTotal();
        const orderId = 'ORD-' + Math.random().toString(36).substring(2, 7).toUpperCase();

        const orderData = {
          id: orderId,
          date: new Date().toLocaleDateString('bn-BD', { year: 'numeric', month: 'long', day: 'numeric' }),
          amount: `৳${grandTotal}`,
          numericTotal: grandTotal,
          items: cart.map(it => ({
            id: String(it.id),
            name: it.name,
            price: Number(it.price),
            image: it.image,
            quantity: Number(it.quantity)
          })),
          status: 'পেন্ডিং',
          method: selectedPaymentMethod === 'COD' ? 'ক্যাশ অন ডেলিভারি' : 'বিকাশ/নগদ',
          customerName: name,
          customerPhone: phone,
          customerAddress: address,
          customerEmail: userProfile.email || '',
          userId: deviceUid,
          orderNote: orderNote,
          deliveryArea: selectedDeliveryZone === 'inside' ? 'ঢাকার ভেতরে' : selectedDeliveryZone === 'outside' ? 'ঢাকার বাইরে' : 'সমগ্র বাংলাদেশ (অল)',
          deliveryFee: fee,
          couponCode: activeAppliedCoupon || '',
          couponDiscount: discountAmount,
          mfsPhone: mfsPhone,
          mfsTrx: mfsTrx,
          createdAt: new Date().toISOString()
        };

        // Save order directly into Firestore
        await setDoc(doc(db, 'orders', orderId), orderData);

        // Auto save user profile if not saved
        if (!userProfile.name) {
          userProfile = { name, phone, email: userProfile.email || '', address };
          localStorage.setItem('sb_user_profile', JSON.stringify(userProfile));
        }

        // Store ID into device my_order_ids
        myOrderIds.unshift(orderId);
        localStorage.setItem('sb_my_order_ids', JSON.stringify(myOrderIds));

        // Confetti Celebration
        try {
          confetti({
            particleCount: 120,
            spread: 100,
            origin: { y: 0.6 }
          });
        } catch (err) {}

        // Reset cart
        cart = [];
        localStorage.removeItem('sb_cart');
        updateCartBadge();
        updateOrdersBadge();

        closeCartDrawer();
        showToast(`অর্ডার সফল হয়েছে! #${orderId}`, 'success');

        setTimeout(() => {
          openMyOrdersModal();
        }, 500);

      } catch (err) {
        console.error('Order placement error:', err);
        showToast('অর্ডারে সাময়িক সমস্যা হয়েছে!', 'error');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<span>অর্ডার কনফার্ম করুন</span>';
        }
      }
    };

    // My Orders Modal & Live Tracking
    window.openMyOrdersModal = function() {
      renderMyOrdersList();
      document.getElementById('myOrdersModal')?.classList.remove('hidden');
    };

    function updateOrdersBadge() {
      const count = myOrderIds.length;
      const badge = document.getElementById('ordersBadgeCount');
      if (badge) {
        if (count > 0) {
          badge.innerText = count;
          badge.classList.remove('hidden');
        } else {
          badge.classList.add('hidden');
        }
      }
      const bottomBadge = document.getElementById('bottomOrdersBadge');
      if (bottomBadge) {
        if (count > 0) {
          bottomBadge.innerText = count;
          bottomBadge.classList.remove('hidden');
        } else {
          bottomBadge.classList.add('hidden');
        }
      }
      const profOrders = document.getElementById('profileOrderCount');
      if (profOrders) profOrders.innerText = `${count} টি`;
    }

    async function renderMyOrdersList() {
      const container = document.getElementById('myOrdersList');
      if (!container) return;

      if (myOrderIds.length === 0) {
        container.innerHTML = `
          <div class="py-12 text-center text-slate-400">
            <svg class="w-8 h-8 text-slate-600 mx-auto mb-1.5"><use href="#icon-box"></use></svg>
            <p class="font-bold text-white text-xs">আপনার কোনো অর্ডার নেই</p>
            <p class="text-[10px] text-slate-400 mt-1">পণ্য অর্ডার করলে এখানে লাইভ স্ট্যাটাস দেখতে পাবেন।</p>
          </div>
        `;
        return;
      }

      container.innerHTML = `
        <div class="text-center py-6 text-slate-500">
          <div class="w-6 h-6 border-2 border-emerald-500 border-t-transparent rounded-full animate-spin mx-auto mb-1.5"></div>
          <p class="text-[10px]">অর্ডার লোড হচ্ছে...</p>
        </div>
      `;

      onSnapshot(collection(db, 'orders'), (snap) => {
        const fetched = [];
        snap.forEach(d => {
          const ord = { id: d.id, ...d.data() };
          if (myOrderIds.includes(ord.id) || ord.userId === deviceUid || (userProfile.phone && ord.customerPhone === userProfile.phone)) {
            fetched.push(ord);
          }
        });

        if (fetched.length === 0) {
          container.innerHTML = '<div class="py-8 text-center text-slate-400 text-xs">কোনো অর্ডার পাওয়া যায়নি</div>';
          return;
        }

        container.innerHTML = fetched.map(o => {
          const status = String(o.status || 'পেন্ডিং');
          const badgeClass = status.includes('ডেলিভার')
            ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/40'
            : status.includes('কনফার্ম')
            ? 'bg-blue-500/20 text-blue-300 border border-blue-500/40'
            : status.includes('শিপ')
            ? 'bg-indigo-500/20 text-indigo-300 border border-indigo-500/40'
            : status.includes('বাতিল')
            ? 'bg-rose-500/20 text-rose-300 border border-rose-500/40'
            : 'bg-amber-500/20 text-amber-300 border border-amber-500/40';

          return `
            <div class="bg-slate-800/90 border border-slate-700/80 rounded-xl p-3 space-y-2">
              <div class="flex justify-between items-start pb-1.5 border-b border-slate-700/70">
                <div>
                  <span class="text-[9px] text-slate-400 block">${o.date || ''}</span>
                  <span class="font-black text-emerald-400 text-xs">অর্ডার #${o.id}</span>
                </div>
                <span class="px-2 py-0.5 rounded-full font-bold text-[9px] ${badgeClass}">${status}</span>
              </div>

              <div class="space-y-1">
                ${(o.items || []).map(it => `
                  <div class="flex items-center gap-2 text-xs">
                    <img src="${it.image}" class="w-6 h-6 object-cover rounded bg-slate-900 shrink-0" />
                    <span class="flex-1 truncate font-medium text-slate-200 text-[11px]">${it.name}</span>
                    <span class="font-bold text-white text-[11px]">${it.quantity}x</span>
                  </div>
                `).join('')}
              </div>

              ${o.orderNote ? `
                <div class="text-[10px] text-slate-400 bg-slate-900/60 p-1.5 rounded-lg border border-slate-800">
                  <span class="font-bold text-slate-300">নোট:</span> ${o.orderNote}
                </div>
              ` : ''}

              <div class="flex justify-between items-center pt-1.5 border-t border-slate-700/70 text-xs">
                <span class="text-slate-400 font-medium text-[11px]">${o.method || 'ক্যাশ অন ডেলিভারি'}</span>
                <span class="font-black text-white">${o.amount}</span>
              </div>
            </div>
          `;
        }).join('');
      });
    }

    // User Profile Modal Logic
    window.openProfileModal = function() {
      const uidEl = document.getElementById('displayUserUid');
      if (uidEl) uidEl.innerText = deviceUid;
      const pName = document.getElementById('profNameInput');
      if (pName) pName.value = userProfile.name || '';
      const pPhone = document.getElementById('profPhoneInput');
      if (pPhone) pPhone.value = userProfile.phone || '';
      const pEmail = document.getElementById('profEmailInput');
      if (pEmail) pEmail.value = userProfile.email || '';
      const pAddr = document.getElementById('profAddressInput');
      if (pAddr) pAddr.value = userProfile.address || '';
      document.getElementById('deleteConfirmBox')?.classList.add('hidden');
      document.getElementById('userProfileModal')?.classList.remove('hidden');
    };

    window.copyUidToClipboard = function() {
      navigator.clipboard?.writeText(deviceUid);
      showToast('ইউজার আইডি কপি হয়েছে!', 'info');
    };

    window.saveUserProfile = async function(e) {
      e.preventDefault();
      const name = document.getElementById('profNameInput')?.value.trim();
      const phone = document.getElementById('profPhoneInput')?.value.trim();
      const email = document.getElementById('profEmailInput')?.value.trim() || '';
      const address = document.getElementById('profAddressInput')?.value.trim() || '';

      if (!name || !phone) {
        showToast('নাম এবং মোবাইল নম্বর দিন!', 'error');
        return;
      }

      userProfile = { name, phone, email, address };
      localStorage.setItem('sb_user_profile', JSON.stringify(userProfile));

      const hName = document.getElementById('headerProfileName');
      if (hName) hName.innerText = name.split(' ')[0];
      const cName = document.getElementById('custName');
      if (cName) cName.value = name;
      const cPhone = document.getElementById('custPhone');
      if (cPhone) cPhone.value = phone;
      const cAddr = document.getElementById('custAddress');
      if (cAddr) cAddr.value = address;

      if (email) {
        try {
          await setDoc(doc(db, 'users', email), { ...userProfile, userId: deviceUid, updatedAt: new Date().toISOString() });
        } catch (err) {}
      }

      showToast('প্রোফাইল সংরক্ষিত হয়েছে!', 'success');
      document.getElementById('userProfileModal')?.classList.add('hidden');
    };

    window.executeDeleteProfile = async function() {
      try {
        if (userProfile.email) {
          try { await deleteDoc(doc(db, 'users', userProfile.email)); } catch (err) {}
        }

        cart = [];
        wishlist = [];
        myOrderIds = [];
        userProfile = { name: '', phone: '', email: '', address: '' };

        localStorage.removeItem('sb_cart');
        localStorage.removeItem('sb_wishlist');
        localStorage.removeItem('sb_my_order_ids');
        localStorage.removeItem('sb_user_profile');

        const newUid = 'usr_' + Math.random().toString(36).slice(2, 9) + Date.now().toString(36).slice(-4);
        deviceUid = newUid;
        localStorage.setItem('sb_device_uid', newUid);

        initUserSession();
        document.getElementById('userProfileModal')?.classList.add('hidden');
        showToast('প্রোফাইল ও ডেটা ডিলিট হয়েছে! নতুন আইডি তৈরি হয়েছে।', 'success');
      } catch (err) {
        console.error(err);
        showToast('প্রোফাইল ডিলিট করতে সমস্যা হয়েছে', 'error');
      }
    };

    // Initialize session on load
    initUserSession();
  </script>
</body>
</html>
